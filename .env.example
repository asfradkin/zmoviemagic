# Copy this file to .env and fill in your values.
# Get a TMDB API key at https://www.themoviedb.org/settings/api

TMDB_API_KEY=your_tmdb_api_key_here
FIRE_TV_IP=192.168.1.100

# Optional (defaults shown)
# Required before startup: generate a stable random value (at least 32 characters).
FLASK_SECRET_KEY=REPLACE_WITH_RANDOM_SESSION_SECRET
# Exact direct browser Host authorities, including port; no forwarded headers used.
# Replace with your approved household addresses. Loopback is not implicitly trusted.
TRUSTED_LAN_CIDRS=127.0.0.1/32,::1/128,192.0.2.10/32
ALLOWED_HOSTS=localhost:5000,127.0.0.1:5000,192.0.2.10:8000,zmm-origin.internal
# Remote routes stay disabled until approved deployment and credential provisioning.
REMOTE_API_ENABLED=false
# Protected external JSON registry; required when remote is enabled.
# API_TOKEN_FILE=/etc/zmoviemagic/api-tokens.json
# SESSION_LIFETIME_SECONDS=43200
# RATE_LIMIT_MAX_BUCKETS=1024
# RATE_LIMIT_IDLE_SECONDS=900
# FLASK_DEBUG=0
# PLAY_COOLDOWN_SECONDS=2
# ADB_TIMEOUT_SECONDS=5
