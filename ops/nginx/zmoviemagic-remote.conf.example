# Include inside nginx's http {} context, after approved placeholder substitution.
# Raw URI validation precedes normalized location matching. No percent encodings,
# duplicate slashes, dot segments, extra queries or Phase 5 routes are admitted.
map $request_uri $zmm_uri_allowed {
    default 0;
    ~^/api/movies$ 1;
    ~^/api/play$ 1;
    ~^/api/status$ 1;
    "~^/api/status[?]request_id=[A-Za-z0-9_-]{1,128}$" 1;
}

server {
    listen 127.0.0.1:8081 default_server;
    server_name _;
    access_log off;
    error_log /var/log/nginx/zmm-remote-error.log crit;
    return 404;
}

server {
    listen 127.0.0.1:8081;
    server_name movies-api.example.net;
    access_log off;
    error_log /var/log/nginx/zmm-remote-error.log crit;
    server_tokens off;
    client_max_body_size 4k;
    client_body_timeout 3s;
    client_header_timeout 3s;
    if ($zmm_uri_allowed = 0) { return 404; }

    proxy_connect_timeout 1s;
    proxy_send_timeout 3s;
    proxy_read_timeout 3s;
    proxy_next_upstream off;
    proxy_redirect off;
    proxy_intercept_errors off;
    # Pass only the headers the application needs. This strips all incoming
    # forwarding, Cloudflare identity/Access, cookie and browser-session headers.
    proxy_pass_request_headers off;
    proxy_set_header Host zmm-origin.internal;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Content-Type $http_content_type;
    proxy_set_header Idempotency-Key $http_idempotency_key;
    proxy_set_header Connection "";

    location = /api/movies {
        if ($request_method != GET) { return 405; }
        proxy_pass http://127.0.0.1:8000/remote/api/movies;
    }
    location = /api/play {
        if ($request_method != POST) { return 405; }
        proxy_pass http://127.0.0.1:8000/remote/api/play;
    }
    location = /api/status {
        if ($request_method != GET) { return 405; }
        proxy_pass http://127.0.0.1:8000/remote/api/status;
    }
    location / { return 404; }
}
