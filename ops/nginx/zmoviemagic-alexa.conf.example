# Separate from the machine API/Access proxy. Include inside nginx's http {}.
# Template only: do not install until DNS, edge policy and rollback are approved.
map $request_uri $zmm_alexa_uri_allowed {
    default 0;
    ~^/alexa$ 1;
}
limit_req_zone $server_name zone=zmm_alexa_rate:1m rate=1r/s;
limit_conn_zone $server_name zone=zmm_alexa_connections:1m;

server {
    listen 127.0.0.1:8082 default_server;
    server_name _;
    access_log off;
    error_log /var/log/nginx/zmm-alexa-error.log crit;
    return 404;
}

server {
    listen 127.0.0.1:8082;
    server_name movies-api.fradkin.net;
    access_log off;
    error_log /var/log/nginx/zmm-alexa-error.log crit;
    server_tokens off;
    client_max_body_size 32k;
    client_header_buffer_size 1k;
    large_client_header_buffers 2 4k;
    client_body_timeout 3s;
    client_header_timeout 3s;
    if ($zmm_alexa_uri_allowed = 0) { return 404; }
    limit_req zone=zmm_alexa_rate burst=4 nodelay;
    limit_req_status 429;
    limit_conn zmm_alexa_connections 4;
    limit_conn_status 429;

    proxy_connect_timeout 1s;
    proxy_send_timeout 3s;
    proxy_read_timeout 6s;
    proxy_next_upstream off;
    proxy_redirect off;
    proxy_intercept_errors off;
    proxy_pass_request_headers off;
    proxy_set_header Host zmm-origin.internal;
    proxy_set_header Content-Type $http_content_type;
    proxy_set_header Signature-256 $http_signature_256;
    proxy_set_header SignatureCertChainUrl $http_signaturecertchainurl;
    proxy_set_header Connection "";
    # Forward the original body unchanged. No bearer/cookie/forwarding trust.
    location = /alexa {
        if ($request_method != POST) { return 405; }
        proxy_pass http://127.0.0.1:8000/alexa;
    }
    location / { return 404; }
}
